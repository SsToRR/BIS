# Optional local overrides
PORT=3000
# DB_FILE=./database/student-network.sqlite
# MAX_USERS sets the initial database capacity (default 500).
# MAX_USERS=500
# Generate a one-time first-admin key with: openssl rand -hex 32
# Enable it in the deployment environment, sign in, open Admin settings, then remove it.
# ADMIN_BOOTSTRAP_TOKEN=
# Set DATABASE_URL to a hosted Postgres connection string (for example from the Vercel Neon integration).
# DATABASE_URL=
